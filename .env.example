# Keys for the examples and the evals. Copy to .env and fill in what you use:
#   cp .env.example .env
# The library itself needs none of these: rules run locally, and you pass your own
# classifier and judge to Guard.

# The LLM, and the LLM judge: any OpenAI-compatible endpoint.
# examples/health_bot.py and the judge in examples/eval/guards.py use these.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
# Leave OPENAI_BASE_URL unset for OpenAI itself, or point it at another provider:
#   Sarvam      OPENAI_BASE_URL=https://api.sarvam.ai/v1     OPENAI_MODEL=sarvam-105b-conversations
#   Groq        OPENAI_BASE_URL=https://api.groq.com/openai/v1
#   OpenRouter  OPENAI_BASE_URL=https://openrouter.ai/api/v1
#   Ollama      OPENAI_BASE_URL=http://localhost:11434/v1    (OPENAI_API_KEY can be anything)
# OPENAI_BASE_URL=

# Speech-to-text and text-to-speech in the voice examples (see make_speech() in each bot).
SARVAM_API_KEY=

# The Jev classifier, for policies (pip install "pipecat-guardrails[jev]").
TYPESAFE_API_KEY=
